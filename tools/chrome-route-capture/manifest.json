{
  "manifest_version": 3,
  "name": "Throne: проверка маршрута вкладки",
  "version": "0.3.0",
  "description": "Показывает домены выбранной вкладки и передаёт в Throne ошибки и замеченные домены.",
  "minimum_chrome_version": "125",
  "permissions": ["debugger", "tabs", "activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1:18472/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Проверить маршрут вкладки", "default_popup": "popup.html"}
}
